#!/bin/sh
# Pre-commit hook to prevent modifications to frozen/sealed files

FROZEN_FILES="
src/engine/MassModule.ts
src/engine/FrictionModule.ts
src/engine/BounceModule.ts
src/engine/RollModule.ts
src/engine/GravityModule.ts
src/engine/VerticalPositionModule.ts
src/engine/Arena.ts
src/engine/ColliderModule.ts
src/engine/RigidbodyModule.ts
src/character/StrengthModule.ts
src/character/JumpModule.ts
src/character/WallEdgeAssistModule.ts
src/engine/physics/StateHistoryBuffer.ts
src/engine/physics/IslandManager.ts
"

STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
  for frozen in $FROZEN_FILES; do
    if [ "$file" = "$frozen" ]; then
      echo "❌ COMMIT BLOCKED BY FROZEN FILES HOOK:"
      echo "   Attempted to commit sealed file: $file"
      echo "   This file is marked complete & read-only in AGENTS.md and .agents/rules/frozen_files.md."
      echo "   If this edit was intentional, unlock it with 'attrib -r $file' and override the hook."
      exit 1
    fi
  done
done

exit 0
