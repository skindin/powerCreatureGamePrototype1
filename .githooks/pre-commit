#!/bin/sh
# Pre-commit hook to prevent modifications to frozen/sealed files and enforce capability & reconciler isolation

FROZEN_FILES="
src/engine/FrictionModule.ts
src/engine/BounceModule.ts
src/engine/RollModule.ts
src/engine/GravityModule.ts
src/engine/VerticalPositionModule.ts
src/engine/Arena.ts
src/engine/ColliderModule.ts
src/engine/RigidbodyModule.ts
src/character/JumpModule.ts
src/character/WallEdgeAssistModule.ts
src/engine/physics/StateHistoryBuffer.ts
src/engine/physics/IslandManager.ts
src/server/ServerJitterBuffer.ts
src/server/ContestedGrabArbiter.ts
src/server/AuthoritativeSnapshotManager.ts
src/engine/physics/RemoteEntityInterpolator.ts
src/engine/physics/PredictionReconciliation.ts
"

STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
  for frozen in $FROZEN_FILES; do
    if [ "$file" = "$frozen" ]; then
      echo "❌ COMMIT BLOCKED BY FROZEN FILES HOOK:"
      echo "   Attempted to commit sealed file: $file"
      echo "   This file is marked complete & read-only in AGENTS.md."
      echo "   If this edit was intentional, unlock it with 'attrib -r $file' and override the hook."
      exit 1
    fi
  done

  # Enforce Cross-Capability Isolation in src/character/capabilities/
  case "$file" in
    src/character/capabilities/*.ts)
      if grep -Eq 'from "\./.*Capability(\.js)?"' "$file"; then
        echo "❌ COMMIT BLOCKED BY CAPABILITY ISOLATION HOOK:"
        echo "   File $file imports a sibling capability module."
        echo "   Each capability in src/character/capabilities/ must remain 1-to-1 isolated."
        exit 1
      fi
      ;;
    src/character/LaserModule.ts|src/character/MeleeModule.ts)
      if grep -Eq 'ThrowModule|WalkingModule|ClimbingModule|JumpModule' "$file"; then
        echo "❌ COMMIT BLOCKED BY CAPABILITY ISOLATION HOOK:"
        echo "   File $file imports another character capability module."
        echo "   Use shared helpers in src/engine/physics/ (e.g. ElevationRaycaster.ts) instead."
        exit 1
      fi
      ;;
  esac
done

exit 0
